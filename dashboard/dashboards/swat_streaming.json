{
  "uid": "swat-continual-learning",
  "title": "SWaT Continual Learning",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Events processed (Influx swat_stream)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influx-swat" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influx-swat" },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"swat_stream\")\n  |> filter(fn: (r) => r._field == \"event_index\")\n  |> aggregateWindow(every: 30s, fn: last, createEmpty: false)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Rolling accuracy proxy (correct field)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influx-swat" },
      "fieldConfig": {
        "defaults": { "min": 0, "max": 1, "custom": { "drawStyle": "line" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influx-swat" },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"swat_stream\" and r._field == \"correct\")\n  |> aggregateWindow(every: 1m, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Drift detections",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "influx-swat" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "influx-swat" },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"swat_stream\" and r._field == \"drift_detected\")\n  |> filter(fn: (r) => r._value == 1)"
        }
      ]
    }
  ]
}
